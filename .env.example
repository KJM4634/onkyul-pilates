# 이 파일만 커밋합니다. 실제 값은 .env.local에 넣으세요 (.gitignore 처리됨).
# Vercel 배포 시 Project Settings > Environment Variables에도 같은 값을 등록하세요.

# Supabase — 브라우저에 노출되어도 되는 공개 키만 넣으세요.
# Dashboard → Project Settings → API Keys 의 publishable 키(sb_publishable_…) 또는 legacy anon 키.
# secret 키(sb_secret_…)를 넣으면 앱이 연결을 거부합니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 사이트 기본 URL (메타 태그/OG용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 주의: SUPABASE_SERVICE_ROLE_KEY는 클라이언트 코드·커밋에 절대 넣지 않습니다.
# 필요해지면 서버 전용으로 .env.local에만 추가합니다.
